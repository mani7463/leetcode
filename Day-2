2)class Solution(object):
    def findArray(self, pref):
        a=[]
        for i in range(len(pref)):
            if i ==0:
                a.append(pref[i])
            else:
                a.append(pref[i]^pref[i-1])
        return a

3)class Solution(object):
    def rearrangeArray(self, nums):
        a=[]
        b=[]
        c=[]
        for i in nums:
            if i<0:
                a.append(i)
            else:
                b.append(i)
        for i in range(len(a)):
            c.append(b[i])
            c.append(a[i])
        return c
        
4)class Solution(object):
    def checkGoodInteger(self, n):
        a=0
        b=0
        
        while n>0:
            r=0
            r=n%10
            a+=r
            b+=(r**2)
            n//=10
        if abs(a-b)>=50:
            return True
        else:
            return False
5)class Solution(object):
    def sumOfTheDigitsOfHarshadNumber(self, x):
        sum=0
        a=x
        while x>0:
            r=0
            r=x%10
            x//=10
            sum+=r
        if a%sum==0:
            return sum
        else:
            return -1

6)class Solution(object):
    def isSameAfterReversals(self, num):
        org = num
        num = str(num)
        rev=int(num[::-1])
        rev1=str(rev)
        rev2=int(rev1[::-1])
        if rev2 == org:
            return True
        else:
            return False
