1)class Solution(object):
    def smallestNumber(self, n, t):
        a=n
        while n>0:
            p=1
            j=n
            while j > 0:
               p *= j % 10
               j //= 10
            
            if p==0:
                return n
            elif p<t:
                n=n+1
            elif n>=a and p%t==0:
                return n
            else:
                n=n+1
2)class Solution(object):
    def addDigits(self, num):
        if num==0:
            return 0
        else:
            while num>0:
                sum=0
                j=num
                while j > 0:
                    sum += j % 10
                    j //= 10
                if num<10:
                    return num
                else:
                    num=sum

3)class Solution(object):
    def shuffle(self, nums, n):
        t=len(nums)
        a=nums[0:n]
        b=nums[n:t]
        c=[]
        for i in range(n):
            c.append(a[i])
            c.append(b[i])
        return c

4)class Solution(object):
    def interpret(self, command):
        command=command.replace("()","o")
        command=command.replace("(al)","al")
        return command

5)class Solution(object):
    def numberOfEmployeesWhoMetTarget(self, hours, target):
        n=len(hours)
        a=0
        for i in range(n):
            if(hours[i]>=target):
                a+=1
            else:
                continue
        return a
6)class Solution(object):
    def countPairs(self, nums, target):
        n=len(nums)
        a=0
        for i in range(n):
            for j in range(n):
                if i<j<n and (nums[i]+nums[j])<target:
                    a+=1
                else:
                    continue
        return a
7)class Solution(object):
    def minElement(self, nums):
        a=[]
        for i in nums:
            s=0
            while i>0:
                r=i%10
                s+=r
                i=i//10
            a.append(s)
        return min(a)
        
